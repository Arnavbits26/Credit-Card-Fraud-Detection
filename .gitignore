# --- Byte-compiled / cache ---
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (raw data can be large / licensed — do not commit) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Trained models (large binaries) ---
models/*
!models/.gitkeep

# --- Generated outputs (regenerated by scripts) ---
outputs/*.png
outputs/*.json
!outputs/.gitkeep

# --- Reports (generated) ---
reports/*
!reports/.gitkeep

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Environment / secrets ---
.env
*.log

# --- Streamlit ---
.streamlit/
